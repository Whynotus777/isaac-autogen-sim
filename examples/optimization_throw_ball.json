{
  "problem_name": "throw_ball_to_target",
  "description": "Optimize initial velocity to throw a ball to hit a target position",
  "objective": "minimize",
  "metrics": [
    {
      "name": "distance_to_target",
      "prim_path": "/World/Ball",
      "metric_type": "distance",
      "target_position": [5.0, 0.0, 1.0],
      "weight": 1.0
    }
  ],
  "parameters": [
    {
      "name": "initial_velocity_x",
      "prim_path": "/World/Ball",
      "parameter_type": "velocity",
      "initial_value": 2.0,
      "min_value": 0.0,
      "max_value": 20.0,
      "learning_rate": 0.1,
      "requires_grad": true
    },
    {
      "name": "initial_velocity_z",
      "prim_path": "/World/Ball",
      "parameter_type": "velocity",
      "initial_value": 5.0,
      "min_value": 0.0,
      "max_value": 20.0,
      "learning_rate": 0.1,
      "requires_grad": true
    }
  ],
  "optimizer_config": {
    "optimizer_type": "adam",
    "learning_rate": 0.1,
    "learning_rate_decay": 0.95,
    "momentum": 0.9,
    "beta1": 0.9,
    "beta2": 0.999,
    "epsilon": 1e-8,
    "clip_grad_norm": 10.0
  },
  "termination": {
    "max_iterations": 100,
    "tolerance": 0.01,
    "min_improvement": 0.001,
    "patience": 15
  },
  "simulation": {
    "num_steps": 300,
    "time_step": 0.016666,
    "enable_gradients": true,
    "gradient_mode": "auto"
  },
  "constraints": []
}
