# Environment variables for Autonomous Simulation Design Platform

# OpenAI API Key (Required for AutoGen agents)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Generative 3D API Keys
# CSM.ai API Key (for AI-generated 3D assets)
CSM_API_KEY=your_csm_api_key_here

# Spline AI API Key (for AI-generated 3D assets)
SPLINE_API_KEY=your_spline_api_key_here

# Alternative LLM Providers (Optional)
# Uncomment and configure if using alternative providers

# Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Azure OpenAI
# AZURE_OPENAI_API_KEY=your_azure_key_here
# AZURE_OPENAI_ENDPOINT=your_azure_endpoint_here

# Local LLM (Ollama)
# OLLAMA_HOST=http://localhost:11434
